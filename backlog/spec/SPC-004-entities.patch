From 3c4db94a39df6d4b1dca57d666ff3b22839496af Mon Sep 17 00:00:00 2001
From: "odd-contributor (Claude)" <noreply@anthropic.com>
Date: Thu, 18 Jun 2026 18:53:09 +0200
Subject: [PATCH] feat(entities): expose ML_MODEL_ARTIFACT + ML_MODEL_INSTANCE;
 document the ML lifecycle types

The platform models the ML lifecycle as: ML_MODEL (the model identity/family, a group),
ML_MODEL_TRAINING (a training job), ML_MODEL_ARTIFACT (a trained model version/artifact),
ML_MODEL_INSTANCE (a deployed serving instance), ML_EXPERIMENT (a group of runs). The ingestion
DataEntityType enum advertised only ML_MODEL + ML_MODEL_TRAINING, so a collector could not send a
trained model (ML_MODEL_ARTIFACT) or a serving instance (ML_MODEL_INSTANCE) -- the gap behind
opendatadiscovery/odd-platform#1725. Add the two values (additive, backward compatible) and a schema
description documenting each ML type with its MLflow/SageMaker/DataHub analogy, so the contract is the
single source of truth and the platform maps it 1:1.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 specification/entities.yaml | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/specification/entities.yaml b/specification/entities.yaml
index 6ccad60..651d63c 100644
--- a/specification/entities.yaml
+++ b/specification/entities.yaml
@@ -591,7 +591,13 @@ components:
 
     DataEntityType:
       type: string
-      enum: 
+      description: >-
+        The kind of a data entity. ML lifecycle types: ML_MODEL is the model identity/family, a group of its
+        lifecycle members (like MLflow Registered Model, SageMaker Model Package Group, or DataHub mlModelGroup);
+        ML_MODEL_TRAINING is a training job (a transformer); ML_MODEL_ARTIFACT is a trained model version/artifact
+        (a consumer); ML_MODEL_INSTANCE is a deployed serving instance (a transformer); ML_EXPERIMENT is a group
+        of training runs.
+      enum:
         - TABLE
         - VIEW
         - FILE
@@ -601,6 +607,8 @@ components:
         - JOB_RUN
         - ML_MODEL
         - ML_MODEL_TRAINING
+        - ML_MODEL_ARTIFACT
+        - ML_MODEL_INSTANCE
         - DASHBOARD
         - DAG
         - ML_EXPERIMENT
-- 
